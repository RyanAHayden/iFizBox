#!/bin/sh
# Register the app with SpringBoard (rootless: the jailbreak maps /var/jb).
# Installed from inside the app (ifizbox-helper sets IFIZBOX_HELPER_PID, the process the app waits on), uicache
# would close the running app while apt and dpkg are still at work, so it waits in the background until that run
# has ended (at most 10 minutes). Its fds are all let go, so neither dpkg nor the helper waits for it.
# B414: a run may end on Restart SpringBoard, Reload SpringBoard or Reboot Device, which wait for the tap: while the
# app is held (ifizbox-helper hold-self, "<pid> <start time>" in $held) and alive, uicache waits on, however long. It
# runs once the app lets go (the file is gone) or has closed.
held=/var/jb/var/lib/ifizbox/held
holding() { p=; s=; read -r p s <"$held" && case "$p" in '' | *[!0-9]*) false ;; *) kill -0 "$p" ;; esac; }
register() { uicache -p /var/jb/Applications/$(BRAND_NAME).app; }
case "$IFIZBOX_HELPER_PID" in
'' | *[!0-9]*) register || true ;;
*)
    (
        n=0
        while [ "$n" -lt 600 ] && kill -0 "$IFIZBOX_HELPER_PID" 2>/dev/null; do sleep 1; n=$((n + 1)); done
        while [ -e "$held" ] && holding; do sleep 1; done
        register
    ) </dev/null >/dev/null 2>&1 3>&- 4>&- 5>&- 6>&- 7>&- 8>&- 9>&- &
    ;;
esac
# The app has no container, so WebKit keeps its localStorage and IndexedDB (Settings, the source cache, Changes) in
# /var/mobile/Library/WebKit/com.ryha.ifizbox/. iOS ships that parent as root:mobile 0700, so WebKit (running as
# mobile) can't create it and keeps everything in memory: every launch starts empty and Changes never shows a
# change. Let group mobile through the parent and make the app's folder for it.
wk=/var/mobile/Library/WebKit
mkdir -p "$wk/com.ryha.ifizbox" && chmod g+x "$wk" && chown mobile:mobile "$wk/com.ryha.ifizbox" || true
# N5: start the daily upgrade check (unload first so an upgrade picks up a changed job).
launchctl unload /var/jb/Library/LaunchDaemons/com.ryha.ifizbox.upgrades.plist 2>/dev/null || true
launchctl load /var/jb/Library/LaunchDaemons/com.ryha.ifizbox.upgrades.plist || true
exit 0
