#!/bin/sh
# A stand-in for ifizbox-helper (native/helper/) for tests without a device (N3, and N4's queue and console).
# Same words, same allowlist and exit codes; instead of apt it works on a fixture tree (addsource/removesource
# edit $IFIZBOX_PREFIX/etc/apt/sources.list.d/ifizbox.sources like the real one, F33):
#   IFIZBOX_PREFIX  the fake rootless prefix (etc/apt, var/lib/apt/lists, var/lib/dpkg/status)
#   FAKE_REMOTE    what "the repos" hold: FAKE_REMOTE/lists/* is what apt-get update writes into the lists dir
#   FAKE_FAIL      a verb that fails like apt does (exit 100, "E: ..." on stderr); simulate fails with an unmet
#                  dependency of the first item on FAKE_MISSING (default com.example.missing), as apt-get -s does
#   FAKE_DEAD      repo URIs (space separated, as in apt's sources) that update can't fetch (B23): their lists aren't
#                  copied, stdout gets apt's "Err:<n> <uri> ./ Packages" and reason line, stderr "E: Failed to fetch ..."
#                  and "E: Some index files failed to download", and update exits 100, as apt does on a dead source
#   FAKE_SLOW      seconds apply waits before each package, so a walk-through sees the console mid-run
#   FAKE_CONFFILE  a conffile path both the user and the package changed (F63): apply keeps it quietly, apply-ask
#                  asks on fd 3 (pmconffile:) and reads Y or N from stdin, as dpkg does through the real helper
#   FAKE_DLWAIT    seconds apply waits after its download pass, before the first pmstatus: line (F64: Cancel's window;
#                  like apt, apply fetches every install item first, dlstatus: lines, then hands them to dpkg)
#   FAKE_DLWAIT_STUBBORN=1  that wait ignores SIGTERM and SIGINT, so Cancel can't count on them reaching it (T62);
#                  it starts with "Waiting, deaf to SIGTERM and SIGINT" on stdout once it ignores them
#   FAKE_FINISH    apply writes "finish:$FAKE_FINISH" to fd 3, as a maintainer script does through $CYDIA (N4)
#   IFIZBOX_IPA_DIR install-ipa's one directory (F59; the real one's HELPER_IPA_DIR). install-ipa reads the IPA's
#                  bundle id like ipa.c and "installs" it into $IFIZBOX_PREFIX/var/fake-installed-ipas:
#   FAKE_APPSYNC=1 AppSync Unified is there (the IPA goes to installd as it is); else FAKE_LDID=1 means ldid signs it
#                  ad hoc first, and neither is exit 69 (can't install ad hoc). A bundle id ending in .refused makes
#                  the fake installd refuse an ad hoc app (exit 69) or an AppSync one (exit 1)
#   rollbacks/rollback (F71) work on $IFIZBOX_PREFIX/var/cache/ifizbox/rollback/<id>/ like the real ones: a "stored
#                  .deb" here is a plain text control stanza (Package, Version, ...), which rollback writes into dpkg's
#                  status in place of the installed one. Ownership isn't checked (the tests run as one user)
#   install-paid (F57) takes a "downloaded .deb" from $IFIZBOX_PAID_DIR (the real one's HELPER_PAID_DIR): a plain text
#                  control stanza as rollback's, checked to be the package and version asked, then written into
#                  dpkg's status like rollback does. FAKE_FAIL=install-paid fails like apt (exit 100)
#   simulate-deb/install-deb (N9) take a shared ".deb" from $IFIZBOX_DEB_DIR (the real one's HELPER_DEB_DIR): a plain
#                  text control stanza as install-paid's, no check of what it is. Its Depends: (names, comma separated)
#                  are resolved as apt would: installed ones skipped, ones in apt's lists installed too, any other an
#                  unmet dependency (exit 100). FAKE_FAIL=install-deb fails like apt (exit 100)
#   update-source  update for one source: copies only FAKE_REMOTE's lists named for its URI (a FAKE_DEAD URI fails as
#                  update does); FAKE_OLD_HELPER=1 refuses the verb (exit 64), as a helper from before it does
#   app-versions (I4) lists the apps of a fake app-container tree, $IFIZBOX_APPS_DIR (default
#                  $IFIZBOX_PREFIX/var/containers/Bundle/Application), as the real one lists installd's
# Status lines go to fd 3 when it is open, like apt's APT::Status-Fd. SPDX-License-Identifier: GPL-3.0-or-later
set -u
prefix=${IFIZBOX_PREFIX:?}
lists=$prefix/var/lib/apt/lists
status=$prefix/var/lib/dpkg/status
st() { { printf '%s\n' "$1" >&3; } 2>/dev/null || true; }
refuse() { echo "ifizbox-helper: $1" >&2; exit 64; }
verb=${1:-}
VERBS="update, install, remove, upgrade, configure, hold, unhold, showhold, addsource, removesource, simulate, apply, apply-ask, respring, install-ipa, selfupdate, rollbacks, rollback, install-paid, userspace-reboot, simulate-deb, install-deb, app-versions, update-source"
[ -n "$verb" ] || refuse "no verb ($VERBS)"
shift
sources=$prefix/etc/apt/sources.list.d/ifizbox.sources
# F33: the same checks as policy.c's helper_uri_ok, helper_suite_ok and helper_component_ok. grep -x matches a
# line, so a value with a newline in it ("https://r/\nTrusted: yes") is refused first.
one_line() { case $1 in *"
"*) return 1 ;; esac; }
uri_ok() {
  one_line "$1" && [ ${#1} -le 1024 ] && printf '%s' "$1" | grep -Eqx 'https?://[A-Za-z0-9][A-Za-z0-9.-]*(:[0-9]{1,5})?/([A-Za-z0-9._~%+/:=,-]*/)?' &&
    ! printf '%s' "${1#*://}" | grep -Eq '/\.\.?/'
}
suite_ok() {
  [ "$1" = ./ ] && return 0
  one_line "$1" && [ ${#1} -le 255 ] && printf '%s' "$1" | grep -Eqx '[A-Za-z0-9._+][A-Za-z0-9._+/-]*' &&
    ! printf '%s' "$1" | grep -Eq '(^|/)\.\.?(/|$)'
}
component_ok() {
  one_line "$1" && [ ${#1} -le 64 ] && printf '%s' "$1" | grep -Eqx '[A-Za-z0-9]([A-Za-z0-9._+/-]*[A-Za-z0-9._+-])?' &&
    ! printf '%s' "$1" | grep -Eq '(^|/)\.\.?(/|$)'
}
case $verb in
  addsource|removesource|update-source)
    [ $# -ge 2 ] || refuse "needs a URI and a suite"
    uri_ok "$1" || refuse "bad URI (http(s)://host[:port]/path/, ending in /, no user, spaces or . segments)"
    suite_ok "$2" || refuse "bad suite"
    uri=$1 suite=$2
    shift 2
    if [ "$verb" = removesource ]; then
      [ $# -eq 0 ] || refuse "removesource takes a URI and a suite only"
    else
      case $suite in
        */) [ $# -eq 0 ] || refuse "a flat suite (ending in /) takes no components" ;;
        *) [ $# -ge 1 ] || refuse "a suite that isn't flat needs components" ;;
      esac
      [ $# -le 16 ] || refuse "too many components"
      for c in "$@"; do component_ok "$c" || refuse "bad component"; done
    fi
    if [ "$verb" = update-source ]; then
      # FAKE_OLD_HELPER=1: a helper from before update-source, which refuses the verb (the app falls back to update)
      [ -z "${FAKE_OLD_HELPER:-}" ] || refuse "unknown verb (${VERBS%, update-source})"
      # update for this one source: only FAKE_REMOTE's lists named for its URI are copied, the rest of the lists
      # dir stays as it is (the real one passes APT::Get::List-Cleanup=0); a URI on FAKE_DEAD fails as update does.
      if [ "${FAKE_FAIL:-}" = "$verb" ]; then
        echo "E: Could not get lock $lists/lock. It is held by process 1 (fake)" >&2
        exit 100
      fi
      mine="$(printf '%s' "$uri" | sed 's#^[a-z]*://##; s#/*$##; s#/#_#g')_"
      for u in ${FAKE_DEAD:-}; do
        [ "${u%/}" = "${uri%/}" ] || continue
        echo "Err:1 ${uri%/} $suite Packages"
        echo "  525  <none> [IP: 192.0.2.1 443]"
        echo "Reading package lists..."
        echo "E: Failed to fetch ${uri%/}/$suite/Packages  525  <none> [IP: 192.0.2.1 443]" >&2
        echo "E: Some index files failed to download. They have been ignored, or old ones used instead." >&2
        exit 100
      done
      n=0
      for f in "${FAKE_REMOTE:?}"/lists/"$mine"*; do
        [ -f "$f" ] || continue
        n=$((n + 1))
        echo "Get:$n ${f##*/}"
        st "dlstatus:$n:50:Retrieving file $n"
        cp "$f" "$lists/"
      done
      echo "Reading package lists..."
      exit 0
    fi
    if [ "${FAKE_FAIL:-}" = "$verb" ]; then
      echo "ifizbox-helper: can't create a temp file in sources.list.d: Permission denied (fake)" >&2
      exit 74
    fi
    mine=
    if [ "$verb" = addsource ]; then
      mine="Types: deb
URIs: $uri
Suites: $suite"
      [ $# -gt 0 ] && mine="$mine
Components: $*"
    fi
    mkdir -p "${sources%/*}"
    tmp="${sources%/*}/.ifizbox.sources.$$"
    # One stanza per paragraph; the first naming exactly this URI and suite becomes ours, the rest go.
    { cat "$sources" 2>/dev/null || true; } | awk -v uri="$uri" -v suite="$suite" -v mine="$mine" '
      BEGIN { RS = ""; placed = (mine == "") }
      {
        u = ""; s = ""
        n = split($0, l, "\n")
        for (i = 1; i <= n; i++) {
          if (tolower(l[i]) ~ /^uris:/) { u = l[i]; sub(/^[^:]*:[ \t]*/, "", u); sub(/[ \t\r]*$/, "", u) }
          if (tolower(l[i]) ~ /^suites:/) { s = l[i]; sub(/^[^:]*:[ \t]*/, "", s); sub(/[ \t\r]*$/, "", s) }
        }
        out = $0
        if (u == uri && s == suite) { if (placed) next; placed = 1; out = mine }
        printf "%s%s\n", (k++ ? "\n" : ""), out
      }
      END { if (!placed) printf "%s%s\n", (k ? "\n" : ""), mine }' > "$tmp"
    if cmp -s "$tmp" "$sources" || { [ ! -s "$tmp" ] && [ ! -e "$sources" ]; }; then
      rm -f "$tmp"
      what="nothing to change"
    elif [ -s "$tmp" ]; then
      chmod 644 "$tmp" && mv "$tmp" "$sources"
      what="ifizbox.sources updated"
    else
      rm -f "$tmp" "$sources"
      what="ifizbox.sources updated"
    fi
    echo "$([ "$verb" = addsource ] && echo Added || echo Removed) $uri $suite: $what"
    exit 0 ;;
  update|upgrade|configure|showhold) [ $# -eq 0 ] || refuse "this verb takes no arguments" ;;
  install|remove|hold|unhold) [ $# -ge 1 ] || refuse "no package names" ;;
  simulate|apply|apply-ask) [ $# -ge 1 ] || refuse "no packages" ;;
  respring) [ $# -eq 0 ] || refuse "this verb takes no arguments"; echo "sbreload (fake)"; exit 0 ;;
  userspace-reboot) [ $# -eq 0 ] || refuse "this verb takes no arguments"; echo "launchctl reboot userspace (fake)"; exit 0 ;;
  app-versions)
    # I4: ipa.c's helper_app_versions over $IFIZBOX_APPS_DIR (default <prefix>/var/containers/Bundle/Application):
    # "<id>\t<short>\t<build>\t<store>" per <UUID>/<one>.app with an XML Info.plist; links aren't followed.
    [ $# -eq 0 ] || refuse "app-versions takes no arguments"
    apps=${IFIZBOX_APPS_DIR:-$prefix/var/containers/Bundle/Application}
    pval() { [ -f "$1" ] && [ ! -L "$1" ] || return 0
      tr -d '\n' < "$1" | sed -n "s|.*<key>$2</key>[[:space:]]*<string>\([^<]*\)</string>.*|\1|p" | grep -Ex '[^[:cntrl:]]{1,255}' || true; }
    for box in "$apps"/*; do
      [ -d "$box" ] && [ ! -L "$box" ] || continue
      set -- "$box"/*.app
      [ $# -eq 1 ] && [ -d "$1" ] && [ ! -L "$1" ] || continue
      id=$(pval "$1/Info.plist" CFBundleIdentifier)
      printf '%s' "$id" | grep -Eqx '[A-Za-z0-9][A-Za-z0-9.-]{0,254}' || continue
      printf '%s\t%s\t%s\t%s\n' "$id" "$(pval "$1/Info.plist" CFBundleShortVersionString)" \
        "$(pval "$1/Info.plist" CFBundleVersion)" "$(pval "$box/iTunesMetadata.plist" bundleShortVersionString)"
    done
    exit 0 ;;
  install-ipa)
    # F59: policy.c's helper_ipa_path_ok, then ipa.c's steps without installd.
    [ $# -eq 1 ] || refuse "install-ipa takes one path"
    dir=${IFIZBOX_IPA_DIR:?}
    case $1 in "$dir"/*) name=${1#"$dir"/} ;; *) name= ;; esac
    { one_line "$1" && [ ${#name} -le 255 ] && printf '%s' "$name" | grep -Eqx '[A-Za-z0-9][A-Za-z0-9._-]*\.ipa' &&
      case $name in *..*) false ;; esac; } || refuse "bad IPA path (only $dir/<name>.ipa)"
    { [ -f "$1" ] && [ ! -L "$1" ]; } || refuse "can't open the IPA (missing, or a link)"
    st "pmstatus:ipa:5:Copying the IPA"
    st "pmstatus:ipa:20:Unpacking"
    id=$(python3 -I -c '
import re, sys, zipfile
try:
    z = zipfile.ZipFile(sys.argv[1])
except Exception:
    sys.exit(9)
apps = {n.split("/")[1] for n in z.namelist() if re.match(r"Payload/[^/]+\.app/", n)}
if len(apps) != 1:
    sys.exit(8)
try:
    text = z.read("Payload/%s/Info.plist" % apps.pop()).decode("utf-8", "replace")
except KeyError:
    sys.exit(7)
m = re.search(r"<key>CFBundleIdentifier</key>\s*<string>([^<]*)</string>", text)
v = m.group(1) if m else ""
if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9.-]{0,254}", v):
    sys.exit(7)
print(v)' "$1")
    case $? in
      0) ;;
      9) refuse "unzip couldn't unpack the IPA" ;;
      8) refuse "not an IPA: no single Payload/<name>.app" ;;
      *) refuse "no usable CFBundleIdentifier in the app's Info.plist" ;;
    esac
    if [ "${FAKE_APPSYNC:-}" = 1 ]; then
      st "pmstatus:$id:50:Installing (AppSync Unified)"
      echo "install ipa $id"
      case $id in *.refused) echo "ifizbox-helper: installd refused the app: fake installd refused it" >&2; exit 1 ;; esac
    elif [ "${FAKE_LDID:-}" = 1 ]; then
      st "pmstatus:$id:40:Signing ad hoc (ldid)"
      echo "ldid -s Payload/$id.app (fake)"
      st "pmstatus:$id:60:Installing (ad hoc signed)"
      echo "install app $id (PackageType Developer)"
      case $id in *.refused) echo "ifizbox-helper: installd: fake installd refused it" >&2
        echo "ifizbox-helper: installd refused the ad hoc signed app: this jailbreak can't install ad hoc apps without AppSync Unified. Install AppSync Unified, or sign the IPA for this iPhone first" >&2
        exit 69 ;; esac
    else
      echo "ifizbox-helper: AppSync Unified isn't installed and there's no ldid to sign the app ad hoc: install AppSync Unified or ldid, or sign the IPA for this iPhone first" >&2
      exit 69
    fi
    echo "$id" >> "$prefix/var/fake-installed-ipas"
    st "pmstatus:$id:100:Installed"
    echo "Installed $id"
    exit 0 ;;
  rollbacks|rollback)
    # F71: policy.c's rollback_plan, helper_rollback_file/list and helper_rollback_verify.
    if [ "$verb" = rollbacks ]; then [ $# -eq 1 ] || refuse "rollbacks takes a package name"
    else [ $# -eq 2 ] || refuse "rollback takes a package name and a version"; fi
    { one_line "$1" && printf '%s' "$1" | grep -Eqx '[A-Za-z0-9][A-Za-z0-9._+-]{1,254}'; } || refuse "bad package name (allowed: [A-Za-z0-9][A-Za-z0-9._+-]+)"
    if [ "$verb" = rollback ]; then
      { one_line "$2" && printf '%s' "$2" | grep -Eqx '[0-9]([A-Za-z0-9.+~:-]{0,253}[A-Za-z0-9.+~:])?'; } || refuse "bad version (a digit, then [A-Za-z0-9.+~:-], not ending in -)"
    fi
    store=$prefix/var/cache/ifizbox/rollback/$1
    found=
    for f in "$store/$1"_*_*.deb; do
      [ -f "$f" ] && [ ! -L "$f" ] || continue
      rest=${f##*/}; rest=${rest#"$1"_}; arch=${rest##*_}; ver=${rest%_*}
      printf '%s' "$ver" | grep -Eqx '[0-9][A-Za-z0-9.+~%-]*' && printf '%s' "${arch%.deb}" | grep -Eqx '[a-z0-9-]+' || continue
      case $ver in *_*) continue ;; esac
      ver=$(printf '%s' "$ver" | sed 's/%3[aA]/:/g')
      if [ "$verb" = rollbacks ]; then echo "$ver ${f##*/}"
      elif [ "$ver" = "$2" ]; then found=$f; break; fi
    done
    [ "$verb" = rollbacks ] && exit 0
    [ -n "$found" ] || refuse "no stored .deb of that version (Roll Back keeps only what automatic updates replaced)"
    { grep -qxF "Package: $1" "$found" && grep -qxF "Version: $2" "$found" &&
      [ "$(grep -c '^Package:' "$found")" = 1 ] && [ "$(grep -c '^Version:' "$found")" = 1 ]; } ||
      refuse "the stored .deb's control isn't that package and version"
    [ -n "${FAKE_SLOW:-}" ] && sleep "$FAKE_SLOW"
    echo "Reading package lists..."
    old=$(awk -v p="$1" 'BEGIN { RS = "" } { n = split($0, l, "\n"); name = ""; v = ""
      for (i = 1; i <= n; i++) { if (l[i] ~ /^Package:/) { name = l[i]; sub(/^Package:[ \t]*/, "", name) }
        if (l[i] ~ /^Version:/) { v = l[i]; sub(/^Version:[ \t]*/, "", v) } }
      if (name == p) { print v; exit } }' "$status" 2>/dev/null)
    st "pmstatus:$1:50:Preparing $1"
    echo "Unpacking $1 ($2)${old:+ over ($old)} ..."
    if [ "${FAKE_FAIL:-}" = rollback ]; then
      echo "dpkg: error processing archive $found (--unpack):" >&2
      echo "E: Sub-process /usr/bin/dpkg returned an error code (1)" >&2
      exit 100
    fi
    { awk -v p="$1" 'BEGIN { RS = ""; ORS = "\n\n" } { n = split($0, l, "\n"); name = ""
        for (i = 1; i <= n; i++) if (l[i] ~ /^Package:/) { name = l[i]; sub(/^Package:[ \t]*/, "", name) }
        if (name != p) print }' "$status"
      awk 'NR == 1 { print; print "Status: install ok installed"; next } { print }' "$found"
      echo; } > "$status.new" && mv "$status.new" "$status"
    echo "Setting up $1 ($2) ..."
    st "pmstatus:$1:100:Installed $1"
    [ -n "${FAKE_FINISH:-}" ] && st "finish:$FAKE_FINISH"
    exit 0 ;;
  install-paid)
    # F57: policy.c's paid_plan (helper_paid_path_ok, name, version), then paid.c's control check and apt-get install.
    [ $# -eq 3 ] || refuse "install-paid takes a .deb path, a package name and a version"
    dir=${IFIZBOX_PAID_DIR:?}
    case $1 in "$dir"/*) name=${1#"$dir"/} ;; *) name= ;; esac
    { one_line "$1" && [ ${#name} -le 255 ] && printf '%s' "$name" | grep -Eqx '[A-Za-z0-9][A-Za-z0-9._-]*\.deb' &&
      case $name in *..*) false ;; esac; } || refuse "bad .deb path (only $dir/<name>.deb)"
    { one_line "$2" && printf '%s' "$2" | grep -Eqx '[A-Za-z0-9][A-Za-z0-9._+-]{1,254}'; } || refuse "bad package name (allowed: [A-Za-z0-9][A-Za-z0-9._+-]+)"
    { one_line "$3" && printf '%s' "$3" | grep -Eqx '[0-9]([A-Za-z0-9.+~:-]{0,253}[A-Za-z0-9.+~:])?'; } || refuse "bad version (a digit, then [A-Za-z0-9.+~:-], not ending in -)"
    { [ -f "$1" ] && [ ! -L "$1" ] && [ -s "$1" ]; } || refuse "can't open the .deb (missing, or a link)"
    deb=$(sed '1{/^!<arch>$/d}' "$1")
    { printf '%s\n' "$deb" | grep -qxF "Package: $2" && printf '%s\n' "$deb" | grep -qxF "Version: $3" &&
      [ "$(printf '%s\n' "$deb" | grep -c '^Package:')" = 1 ] && [ "$(printf '%s\n' "$deb" | grep -c '^Version:')" = 1 ]; } ||
      refuse "the downloaded .deb isn't that package and version"
    echo "Reading package lists..."
    st "pmstatus:$2:50:Preparing $2"
    echo "Unpacking $2 ($3) ..."
    if [ "${FAKE_FAIL:-}" = install-paid ]; then
      echo "E: Sub-process /usr/bin/dpkg returned an error code (1)" >&2
      exit 100
    fi
    { awk -v p="$2" 'BEGIN { RS = ""; ORS = "\n\n" } { n = split($0, l, "\n"); name = ""
        for (i = 1; i <= n; i++) if (l[i] ~ /^Package:/) { name = l[i]; sub(/^Package:[ \t]*/, "", name) }
        if (name != p) print }' "$status"
      printf '%s\n' "$deb" | awk 'NR == 1 { print; print "Status: install ok installed"; next } { print }'
      echo; } > "$status.new" && mv "$status.new" "$status"
    echo "Setting up $2 ($3) ..."
    st "pmstatus:$2:100:Installed $2"
    exit 0 ;;
  simulate-deb|install-deb)
    # N9: policy.c's local_deb_plan (helper_paid_path_ok over HELPER_DEB_DIR), then paid.c's copy and apt-get.
    [ $# -eq 1 ] || refuse "$verb takes one .deb path"
    dir=${IFIZBOX_DEB_DIR:?}
    case $1 in "$dir"/*) name=${1#"$dir"/} ;; *) name= ;; esac
    { one_line "$1" && [ ${#name} -le 255 ] && printf '%s' "$name" | grep -Eqx '[A-Za-z0-9][A-Za-z0-9._-]*\.deb' &&
      case $name in *..*) false ;; esac; } || refuse "bad .deb path (only $dir/<name>.deb)"
    { [ -f "$1" ] && [ ! -L "$1" ] && [ -s "$1" ]; } || refuse "can't open the .deb (missing, or a link)"
    deb=$(sed '1{/^!<arch>$/d}' "$1")
    pkg=$(printf '%s\n' "$deb" | sed -n 's/^Package:[ \t]*//p' | head -n 1)
    ver=$(printf '%s\n' "$deb" | sed -n 's/^Version:[ \t]*//p' | head -n 1)
    deps=$(printf '%s\n' "$deb" | sed -n 's/^Depends:[ \t]*//p' | head -n 1 | tr ',' ' ')
    [ -n "$pkg" ] && [ -n "$ver" ] || { echo "E: Invalid archive signature" >&2; echo "E: Could not read meta data from $1" >&2; exit 100; }
    echo "Reading package lists..."
    echo "Note, selecting '$pkg' instead of '$1'"
    # the newest-listed version of $1 in apt's lists (versions_in below isn't defined yet here)
    # Line by line: the fixture's lists have stanzas parted by a line of spaces, which awk's paragraph mode misses.
    lv() { cat "$lists"/*_Packages 2>/dev/null | awk -v p="$1" '/^Package:/ { if (name == p && v != "") { print v; done = 1; exit }
        name = $2; v = "" } /^Version:/ { v = $2 } END { if (!done && name == p && v != "") print v }'; }
    stanza_of() { cat "$lists"/*_Packages 2>/dev/null | awk -v p="$1" '/^Package:/ { if (on) exit; on = ($2 == p) }
        /^[ \t]*$/ { if (on) exit; next } on { print }'; }
    need=
    for d in $deps; do
      grep -qx "Package: $d" "$status" 2>/dev/null && continue
      if cat "$lists"/*_Packages 2>/dev/null | grep -qx "Package: $d"; then need="$need $d"; continue; fi
      echo "The following packages have unmet dependencies:"
      echo " $pkg : Depends: $d but it is not installable"
      echo "E: Unable to correct problems, you have held broken packages." >&2
      exit 100
    done
    if [ "$verb" = simulate-deb ]; then
      for d in $need; do v=$(lv "$d"); echo "Inst $d ($v Fake:1.0/stable [iphoneos-arm64])"; done
      old=$(awk -v p="$pkg" 'BEGIN { RS = "" } { n = split($0, l, "\n"); name = ""; v = ""
          for (i = 1; i <= n; i++) { if (l[i] ~ /^Package:/) { name = l[i]; sub(/^Package:[ \t]*/, "", name) }
            if (l[i] ~ /^Version:/) { v = l[i]; sub(/^Version:[ \t]*/, "", v) } }
          if (name == p) { print v; exit } }' "$status" 2>/dev/null)
      if [ -n "$old" ]; then echo "Inst $pkg [$old] ($ver local-deb [iphoneos-arm64])"
      else echo "Inst $pkg ($ver local-deb [iphoneos-arm64])"; fi
      for d in $need; do v=$(lv "$d"); echo "Conf $d ($v Fake:1.0/stable [iphoneos-arm64])"; done
      echo "Conf $pkg ($ver local-deb [iphoneos-arm64])"
      exit 0
    fi
    st "pmstatus:$pkg:50:Preparing $pkg"
    echo "Unpacking $pkg ($ver) ..."
    if [ "${FAKE_FAIL:-}" = install-deb ]; then
