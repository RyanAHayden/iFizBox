 map<void*, void*> ZFile::s_mapFiles;
 
+#ifdef __EMSCRIPTEN__
+// Emscripten's mmap copies the file in and, for MAP_SHARED, back out at munmap. Here that copy is plain malloc, read and
+// write (iFizBox F265): one buffer, reserved at the size of the app's biggest executable, serves one mapping after the
+// other, and a changed executable is written from it into a file that deflates as it is written
+// (web/app/websign-stream.js). `save` false drops the mapping's changes. Nothing here may fail quietly: an executable that
+// can't be mapped would be left unsigned.
+struct MappedFile { string path; size_t size; bool ro; };
+static map<void*, MappedFile> s_mapped;
+static void* s_reserve = NULL;
+static size_t s_reserveSize = 0;
+static bool s_reserveUsed = false;
+
+bool ZFile::ReserveMap(size_t size)
+{
+	if (s_reserveUsed) {
+		return false;
+	}
+	free(s_reserve);
+	s_reserve = malloc(size);
+	s_reserveSize = NULL != s_reserve ? size : 0;
+	return NULL != s_reserve;
+}
+
+static void ReleaseMap(void* base)
+{
+	if (base == s_reserve) {
+		s_reserveUsed = false;
+	} else {
+		free(base);
+	}
+}
+
+static void* ReadMap(const char* path, int fd, size_t offset, size_t size, bool ro)
+{
+	if (0 == size) {
+		return NULL;
+	}
+	void* base = NULL;
+	if (!s_reserveUsed && size <= s_reserveSize) {
+		base = s_reserve;
+		s_reserveUsed = true;
+	} else {
+		base = malloc(size);
+		if (NULL == base) {
+			abort(); // out of memory
+		}
+	}
+	size_t got = 0;
+	while (got < size) {
+		ssize_t n = pread(fd, (uint8_t*)base + got, size - got, (off_t)(offset + got));
+		if (n <= 0) {
+			ReleaseMap(base);
+			return NULL;
+		}
+		got += (size_t)n;
+	}
+	s_mapped[base] = { path, size, ro };
+	return base;
+}
+#endif
