{ "name": "promo-sideload", "liveKeyboard": true, "storage": {"ifizbox.appearance": "light", "ifizbox.iconMatch": "false", "ifizbox.installRoute": "iphone"},
 "override": {"/core/gsa.js": "gsa.js", "/core/freeroute.js": "freeroute.js"}, "steps": [
 {"phone": "fresh"},
 {"record": true},
 {"mark": "home"}, {"pause": 700},

 {"tap": "text=Settings"}, {"pause": 700},
 {"tap": "text=Installation & Signing"}, {"pause": 800},
 {"mark": "signing"},
 {"tap": "text=Import Certificate"}, {"pause": 900},
 {"mark": "certpage"},
 {"tap": "text=Import Certificate"}, {"eval": "__pick.show()"}, {"pause": 1300},
 {"mark": "picker"},
 {"eval": "__pick.hide()"}, {"eval": "__pick.files()"}, {"pause": 500},
 {"mark": "importing"},
 {"pause": 1200},
 {"mark": "imported"}, {"pause": 1000},

 {"tap": "text=Remove Certificate"}, {"pause": 900},
 {"mark": "remove"},
 {"tap": "text=Remove", "nth": -1}, {"pause": 1000},
 {"swipe": [[210, 700], [210, 200]], "ms": 320}, {"pause": 500},
 {"swipe": [[210, 700], [210, 200]], "ms": 320}, {"pause": 600},
 {"mark": "free"},
 {"tap": "text=Use a Free Apple ID"}, {"pause": 600},
 {"tap": "input[type=email]"}, {"pause": 100}, {"type": "taylor@example.com", "cps": 80}, {"pause": 100},
 {"tap": "input[type=password]"}, {"pause": 100}, {"type": "bluebirdsfly", "cps": 80}, {"pause": 100},
 {"tap": "text=Sign In"}, {"pause": 300},
 {"until": "document.body.textContent.includes('Two-Factor')", "max": 8000}, {"pause": 300},
 {"tap": "input[type=tel]"}, {"pause": 100}, {"type": "482915", "cps": 80}, {"pause": 100},
 {"tap": "text=Verify"}, {"pause": 300},
 {"until": "document.body.textContent.includes('Expires')", "max": 15000}, {"pause": 600},
 {"swipe": [[210, 300], [210, 700]], "ms": 400}, {"pause": 900},
 {"mark": "free-done"},

 {"tap": "text=Sources", "nth": -1}, {"pause": 800},
 {"mark": "sources"},
 {"tap": "text=Add"}, {"pause": 500},
 {"tap": ".alert input"}, {"pause": 200},
 {"type": "harbor.example", "cps": 24}, {"pause": 300},
 {"tap": "text=Add Source"},
 {"until": "document.body.textContent.includes('Add & Trust')"}, {"pause": 500},
 {"tap": "text=Add & Trust"},
 {"until": "[...document.querySelectorAll('.page.is-top *')].some((e) => e.textContent === 'Harbor Apps')"}, {"pause": 700},
 {"mark": "source-added"},
 {"tap": "text=Add"}, {"pause": 500},
 {"tap": ".alert input"}, {"pause": 200},
 {"type": "driftwood.example", "cps": 40}, {"pause": 300},
 {"tap": "text=Add Source"},
 {"until": "document.body.textContent.includes('Add & Trust')"}, {"pause": 300},
 {"tap": "text=Add & Trust"}, {"pause": 1500},
 {"tap": "text=Search", "nth": -1}, {"pause": 600},
 {"tap": "input", "nth": -1, "go": "search"}, {"pause": 250},
 {"type": "tide", "cps": 24},
 {"until": "[...document.querySelectorAll('.page.is-top *, .search-results *')].some((e) => e.textContent === 'Tidewell')"}, {"pause": 500},
 {"key": "return"}, {"pause": 500},
 {"tap": "text=Tidewell"}, {"pause": 1500},
 {"mark": "app"},
 {"tap": "text=Install"}, {"pause": 1300},
 {"mark": "confirm-install"},
 {"tap": "text=Confirm", "nth": -1}, {"pause": 700},
 {"mark": "installing"},
 {"until": "document.body.textContent.includes('Open Tidewell')", "max": 20000}, {"pause": 1200},
 {"mark": "installed"},
 {"tap": "text=Return to iFizBox"}, {"pause": 1200},
 {"mark": "details"},

 {"tap": "text=Add Tweaks"}, {"pause": 1200},
 {"mark": "addtweaks"},
 {"tap": "text=ADD", "nth": 0}, {"pause": 1300},
 {"mark": "added"},
 {"tap": "text=Installed", "nth": -1}, {"pause": 900},
 {"tap": "text=Queue"}, {"pause": 1300},
 {"mark": "confirm-tweak"},
 {"tap": "text=Confirm", "nth": -1}, {"pause": 1000},
 {"mark": "tweak-running"},
 {"until": "document.body.textContent.includes('Return to iFizBox')", "max": 30000}, {"pause": 1200},
 {"mark": "tweak-done"},
 {"tap": "text=Return to iFizBox"}, {"pause": 1600},
 {"mark": "tweak-installed"},

 {"world": "update"},
 {"tap": "text=Changes", "nth": -1}, {"pause": 900},
 {"mark": "changes"},
 {"swipe": [[205, 300], [212, 540]], "ms": 520, "rest": 120},
 {"until": "document.body.textContent.includes('Upgrade (1)')", "max": 15000}, {"pause": 1300},
 {"mark": "update-found"},
 {"tap": "text=Upgrade (1)"}, {"pause": 1100},
 {"mark": "confirm-update"},
 {"tap": "text=Confirm", "nth": -1}, {"pause": 700},
 {"until": "document.body.textContent.includes('Open Tidewell')", "max": 20000}, {"pause": 1000},
 {"mark": "updated"},
 {"tap": "text=Return to iFizBox"}, {"pause": 1200},
 {"mark": "up-to-date"},

 {"phone": "aging"},
 {"tap": "text=Home", "nth": -1}, {"pause": 700},
 {"tap": "text=Back"}, {"pause": 800},
 {"tap": "text=Signed Apps"}, {"pause": 1200},
 {"mark": "signedapps"},
 {"tap": "text=Re-sign All"}, {"pause": 1000},
 {"mark": "resignconfirm"},
 {"tap": "text=Confirm", "nth": -1}, {"pause": 800},
 {"mark": "resigning"},
 {"until": "document.body.textContent.includes('Return to iFizBox')", "max": 30000}, {"pause": 900},
 {"mark": "resigned"},
 {"tap": "text=Return to iFizBox"}, {"pause": 900},
 {"tap": "text=Back"}, {"pause": 800},
 {"tap": "text=Signed Apps"}, {"pause": 1200},
 {"mark": "end"}
]}
