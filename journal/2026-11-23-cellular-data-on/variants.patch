diff --git i/native/sideload/vpn/App/Variants.swift w/native/sideload/vpn/App/Variants.swift
new file mode 100644
index 00000000..a6d808e6
--- /dev/null
+++ w/native/sideload/vpn/App/Variants.swift
@@ -0,0 +1,186 @@
+// T76 TEST BUILD ONLY, never merged. ifizbox://vpn-variants opens a page with Run All;
+// ?v=V1 [&keep=1] runs one (keep: leaves the tunnel up), ?v=V1&only=1 tests the tunnel that is up already,
+// ?down=1 turns it off. Results also go to Documents/vpn-variants.txt.
+// SPDX-License-Identifier: GPL-3.0-or-later
+import Foundation
+import Network
+import NetworkExtension
+import UIKit
+
+enum Variants {
+    static let all = ["V5", "V1", "V1b", "V2", "V3", "V4", "V4b"]
+    static let what = ["V5": "current", "V1": "remote 127.0.0.1", "V1b": "remote + server 127.0.0.1", "V2": "192.0.2.x pair",
+                       "V3": "IPv6 pair", "V4": "no excluded default", "V4b": "default route included"]
+    static var current = "V5"
+    static var peer: String { current == "V2" ? "192.0.2.11" : current == "V3" ? "fd00:a7::2" : "10.7.0.1" }
+    static var server: String { current == "V1b" ? "127.0.0.1" : "10.7.0.1" }
+    static let file = FileManager.default.urls(for: .documentDirectory, in: .userDomainMask)[0].appendingPathComponent("vpn-variants.txt")
+    static let q = DispatchQueue(label: "variants")
+    static var text = ""
+    static weak var view: UITextView?
+
+    static func out(_ s: String) {
+        IDevice.ilog("T76 \(s)")
+        DispatchQueue.main.async {
+            text += s + "\n"
+            view?.text = text
+            try? text.write(to: file, atomically: true, encoding: .utf8)
+        }
+    }
+
+    static func receive(_ url: URL) -> Bool {
+        guard url.host == "vpn-variants" else { return false }
+        let items = URLComponents(url: url, resolvingAgainstBaseURL: false)?.queryItems ?? []
+        let v = { (k: String) in items.first { $0.name == k }?.value }
+        if v("down") != nil { q.async { stop(); out("down") }; return true }
+        if let one = v("v"), all.contains(one) { q.async { run(one, keep: v("keep") != nil, only: v("only") != nil) }; return true }
+        DispatchQueue.main.async { present() }
+        return true
+    }
+
+    static func present() {
+        guard view == nil, let top = MyIPAs.topController() else { return }
+        top.present(UINavigationController(rootViewController: VariantsPage()), animated: true)
+    }
+
+    static func runAll() {
+        q.async {
+            out("=== \(Date()) ===")
+            var sum: [String] = []
+            for v in all { sum.append("\(v) \(what[v]!): \(run(v, keep: false, only: false) ? "PASS" : "FAIL")") }
+            current = "V5"
+            _ = try? LocalVPN.refresh() // serverAddress back to the current build's
+            out("\n--- RESULT ---\n" + sum.joined(separator: "\n"))
+        }
+    }
+
+    static func stop() {
+        _ = try? LocalVPN.manager() // a fresh launch has no cached manager
+        LocalVPN.down()
+        let t = Date()
+        while LocalVPN.connectedNow() && Date().timeIntervalSince(t) < 5 { Thread.sleep(forTimeInterval: 0.1) }
+        Thread.sleep(forTimeInterval: 1.5)
+    }
+
+    @discardableResult static func run(_ v: String, keep: Bool, only: Bool) -> Bool {
+        if !only { stop() }
+        current = v
+        out("\n[\(v)] \(what[v]!) \(Date())")
+        do {
+            if !only { try LocalVPN.refresh(); try LocalVPN.up() }
+            Thread.sleep(forTimeInterval: 1)
+            out("tunnel: \(LocalVPN.ask())")
+        } catch {
+            out("no tunnel: \((error as? IDevice.Failure)?.text ?? "\(error)")")
+            return false
+        }
+        sample()
+        let t0 = Date()
+        var pass = false
+        do {
+            // as vpn.test: begin (the VPN is up already), verify, end
+            let kind = try IDevice.verify()
+            pass = true
+            out("vpn.test PASS \(Int(Date().timeIntervalSince(t0) * 1000)) ms, \(kind.rawValue)")
+        } catch { out("vpn.test FAIL \(Int(Date().timeIntervalSince(t0) * 1000)) ms: \((error as? IDevice.Failure)?.text ?? "\(error)")") }
+        if !keep { stop() }
+        return pass
+    }
+
+    static func sample() {
+        out("path: " + wholePath())
+        for i in interfaces() { out("if " + i) }
+        for p in [IDevice.remotePairingPort, IDevice.lockdownPort] { out("tcp \(peer) \(p): \(VPNCheck.probe(p))") }
+        out("nw: " + connPath())
+    }
+
+    static func wholePath() -> String {
+        let m = NWPathMonitor(); let sem = DispatchSemaphore(value: 0); var s = "none"
+        m.pathUpdateHandler = { s = describe($0); sem.signal() }
+        m.start(queue: .global()); _ = sem.wait(timeout: .now() + 2); m.cancel()
+        return s
+    }
+
+    static func describe(_ p: Network.NWPath) -> String {
+        "\(p.debugDescription) expensive=\(p.isExpensive) wifi=\(p.usesInterfaceType(.wifi)) cell=\(p.usesInterfaceType(.cellular)) other=\(p.usesInterfaceType(.other)) ifs=\(p.availableInterfaces.map { "\($0.name):\($0.type)" }.joined(separator: ","))"
+    }
+
+    /// The path an NWConnection to the peer takes (its interface, and the type iOS gives it through the delegate).
+    static func connPath() -> String {
+        let c = NWConnection(host: NWEndpoint.Host(peer), port: NWEndpoint.Port(rawValue: IDevice.lockdownPort)!, using: .tcp)
+        let sem = DispatchSemaphore(value: 0); var s = "no answer", done = false
+        c.stateUpdateHandler = { st in
+            switch st {
+            case .ready, .failed, .waiting:
+                guard !done else { return }
+                done = true
+                s = "\(st) " + (c.currentPath.map(describe) ?? "no path"); sem.signal()
+            default: break
+            }
+        }
+        c.start(queue: DispatchQueue(label: "nw")); _ = sem.wait(timeout: .now() + 4); c.cancel()
+        return s
+    }
+
+    // XNU bsd/sys/sockio_private.h: _IOWR('i', n, struct ifreq); struct ifreq is 32 bytes, the answer at offset 16
+    private static func ioc(_ n: UInt) -> UInt { 0xC000_0000 | (32 << 16) | (0x69 << 8) | n }
+
+    private static func ask(_ fd: Int32, _ name: String, _ n: UInt) -> String {
+        var b = [UInt8](repeating: 0, count: 32)
+        for (i, c) in name.utf8.prefix(15).enumerated() { b[i] = c }
+        let rc = b.withUnsafeMutableBytes { raw in t76_ioctl(fd, ioc(n), raw.baseAddress!) }
+        if rc != 0 { return "errno \(errno)" }
+        return "\(b[16..<20].enumerated().reduce(UInt32(0)) { $0 | UInt32($1.element) << (8 * UInt32($1.offset)) })"
+    }
+
+    static func interfaces() -> [String] {
+        var head: UnsafeMutablePointer<ifaddrs>?
+        guard getifaddrs(&head) == 0 else { return ["getifaddrs errno \(errno)"] }
+        defer { freeifaddrs(head) }
+        var names: [String] = [], addrs: [String: [String]] = [:], kind: [String: String] = [:]
+        var p = head
+        while let i = p {
+            defer { p = i.pointee.ifa_next }
+            guard let a = i.pointee.ifa_addr else { continue }
+            let n = String(cString: i.pointee.ifa_name)
+            if !names.contains(n) { names.append(n) }
+            if a.pointee.sa_family == sa_family_t(AF_LINK), let d = i.pointee.ifa_data {
+                kind[n] = "ift=0x\(String(d.load(as: UInt8.self), radix: 16)) flags=0x\(String(i.pointee.ifa_flags, radix: 16))"
+            } else {
+                var h = [CChar](repeating: 0, count: Int(NI_MAXHOST))
+                if getnameinfo(a, socklen_t(a.pointee.sa_len), &h, socklen_t(h.count), nil, 0, NI_NUMERICHOST) == 0 { addrs[n, default: []].append(String(cString: h)) }
+            }
+        }
+        let fd = socket(AF_INET, SOCK_DGRAM, 0)
+        defer { close(fd) }
+        return names.filter { n in ["utun", "en0", "pdp_ip0", "lo0", "ipsec"].contains { n.hasPrefix($0) } && !(addrs[n] ?? []).isEmpty }.map { n in
+            let del = ask(fd, n, 157)
+            var dname = ""
+            if let x = UInt32(del), x != 0 {
+                var buf = [CChar](repeating: 0, count: Int(IF_NAMESIZE))
+                if if_indextoname(x, &buf) != nil { dname = "(" + String(cString: buf) + ")" }
+            }
+            return "\(n) #\(if_nametoindex(n)) \(kind[n] ?? "") delegate=\(del)\(dname) type=\(ask(fd, n, 159)) functional=\(ask(fd, n, 173)) expensive=\(ask(fd, n, 160)) \(addrs[n]!.joined(separator: " "))"
+        }
+    }
+}
+
+final class VariantsPage: UIViewController {
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        title = "Tunnel Variants"
+        view.backgroundColor = .white
+        overrideUserInterfaceStyle = .light
+        let tv = UITextView(frame: view.bounds)
+        tv.autoresizingMask = [.flexibleWidth, .flexibleHeight]
+        tv.isEditable = false
+        tv.font = .monospacedSystemFont(ofSize: 11, weight: .regular)
+        tv.text = Variants.text.isEmpty ? "Tap Run All. It takes about a minute and changes no setting; another VPN goes off while it runs." : Variants.text
+        view.addSubview(tv)
+        Variants.view = tv
+        navigationItem.leftBarButtonItem = UIBarButtonItem(title: "Run All", style: .done, target: self, action: #selector(run))
+        navigationItem.rightBarButtonItem = UIBarButtonItem(title: "Copy", style: .plain, target: self, action: #selector(copyAll))
+    }
+    @objc func run() { Variants.runAll() }
+    @objc func copyAll() { UIPasteboard.general.string = Variants.text }
+}
