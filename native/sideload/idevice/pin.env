# The idevice source build.sh compiles (MIT, Jackson Coxson). Bump the commit on purpose and re-run test_idevice.py.
IDEVICE_REPO=https://github.com/jkcoxson/idevice.git
IDEVICE_COMMIT=2dca9a58a9a1dd02ec7d6213fcfd8fe861e74132 # v0.1.68-14, 2026-11-16
# Only what the install route uses: TCP lockdown (iOS 15-17.3), the RPPairing tunnel + RSD (iOS 17.4+/27), the
# pairable host (pairing on the phone, iOS 27), AFC upload, installation_proxy, heartbeat, misagent (F458: a free
# Apple ID's refresh installs profiles). ring, not aws-lc: aws-lc needs cmake and a Mac-flavoured toolchain to cross-build.
IDEVICE_FEATURES=ring,tcp,afc,installation_proxy,heartbeat,rsd,remote_pairing,core_device_proxy,tunnel_tcp_stack,misagent
