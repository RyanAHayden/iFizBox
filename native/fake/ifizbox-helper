esac
# N4: the versions of package $2 in file(s) $1..., one per line (status: installed ones only).
lower() { printf '%s' "$1" | tr A-Z a-z; }
versions_in() {
  p=$1; shift
  awk -v p="$p" 'BEGIN { RS = "" } {
    n = split($0, l, "\n"); name = ""; v = ""; st = ""
    for (i = 1; i <= n; i++) {
      if (l[i] ~ /^Package:/) { name = l[i]; sub(/^Package:[ \t]*/, "", name) }
      if (l[i] ~ /^Version:/) { v = l[i]; sub(/^Version:[ \t]*/, "", v) }
      if (l[i] ~ /^Status:/) st = l[i]
    }
    if (tolower(name) == tolower(p) && v != "" && (st == "" || st ~ / installed$/)) print v
  }' "$@" 2>/dev/null
}
installed_version() { versions_in "$1" "$status" | head -n 1; }
# A stanza's Package and Version, by field (names hold "." and "+", so no regexes on them).
FIELDS='function field(f,   n, l, i, v) { n = split($0, l, "\n"); for (i = 1; i <= n; i++) if (index(l[i], f ":") == 1) { v = substr(l[i], length(f) + 2); sub(/^[ \t]*/, "", v); sub(/[ \t\r]*$/, "", v); return v } return "" }'
# The stanza of package $1 at version $2 from apt's lists (for apply's new status entry).
stanza_of() {
  awk -v p="$1" -v v="$2" "$FIELDS"' BEGIN { RS = "" } tolower(field("Package")) == p && field("Version") == v { print; exit }' "$lists"/*_Packages 2>/dev/null
}
# dpkg's status without package $1.
drop_pkg() { awk -v p="$1" "$FIELDS"' BEGIN { RS = ""; ORS = "\n\n" } field("Package") != p' "$status"; }
# F63: dpkg's conffile question for $FAKE_CONFFILE, once per run (after the first install item's unpack). apply
# keeps the old copy silently (--force-confold); apply-ask asks on fd 3 as apt's pmconffile: line and reads the
# answer as the real helper relays it: only "Y" or "N" lines count (others: the helper's warning), end of file is
# dpkg's error. The outcome goes into $IFIZBOX_PREFIX/var/fake-conffiles as "keep <file>" or "new <file>".
asked=
conffile() {
  [ -n "${FAKE_CONFFILE:-}" ] && [ -z "$asked" ] || return 0
  asked=1
  f=$FAKE_CONFFILE
  if [ "$verb" = apply ]; then echo "keep $f" >> "$prefix/var/fake-conffiles"; return 0; fi
  echo ""
  echo "Configuration file '$f'"
  echo " ==> Modified (by you or by a script) since installation."
  echo " ==> Package distributor has shipped an updated version."
  echo " The default action is to keep your current version."
  echo "*** ${f##*/} (Y/I/N/O/D/Z) [default=N] ?"
  st "pmconffile:$f:60:'$f' '$f.dpkg-new' 1 1"
  while :; do
    if ! IFS= read -r ans <&5; then
      echo "dpkg: error processing package $1 (--configure):"
      echo " end of file on stdin at conffile prompt"
      echo "E: Sub-process /usr/bin/dpkg returned an error code (1)" >&2
      exit 100
    fi
    case $ans in
      Y) echo "Installing new version of config file $f ..."; echo "new $f" >> "$prefix/var/fake-conffiles"; return 0 ;;
      N) echo "keep $f" >> "$prefix/var/fake-conffiles"; return 0 ;;
      *) echo "ifizbox-helper: ignored an answer that isn't Y or N" >&2 ;;
    esac
  done
}
exec 5<&0
